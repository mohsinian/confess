# ── Provider variant 1: AgentRouter proxy (what we built with) ──────────────
# Docs: https://agentrouter.org/docs/claude-code.html
# Base URL has NO /v1 suffix. Token is sent as Bearer.
ANTHROPIC_AUTH_TOKEN=your-agentrouter-api-key
ANTHROPIC_BASE_URL=https://agentrouter.org
# Run `npm run smoke` to verify auth and pick the model, then set the winner:
# ANTHROPIC_MODEL=claude-opus-5

# ── Provider variant 2: direct Anthropic ───────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# Budget guard per case (USD): a case aborts beyond this. Default 8.
# MAX_RUN_COST=5
