# confess-audit provider configuration — copy to .env and fill in ONE variant.
# Easiest path: `npx confess-audit setup` writes this file for you, then
# `npx confess-audit doctor` verifies it.

# ── Variant 1: Anthropic API (direct) ───────────────────────────────────────
# Key from https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# Model is pinned to the first working candidate unless you set it:
# ANTHROPIC_MODEL=claude-opus-5

# ── Variant 2: Anthropic-compatible router (Bearer token) ───────────────────
# Docs: https://agentrouter.org/docs/claude-code.html
# Base URL has NO /v1 suffix. Token is sent as Bearer.
# ANTHROPIC_AUTH_TOKEN=your-router-key
# ANTHROPIC_BASE_URL=https://agentrouter.org
# ANTHROPIC_MODEL=claude-opus-5

# ── Variant 3: OpenAI-compatible API ────────────────────────────────────────
# OpenRouter, Together, Groq, vLLM, LM Studio — anything speaking
# /v1/chat/completions. Base URL INCLUDES /v1 (or your server's equivalent).
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# OPENAI_MODEL=anthropic/claude-opus-4

# ── Variant 4: local Ollama (free, private — no API key) ────────────────────
# Or skip this file entirely: `npx confess-audit --local --model <name>`.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5-coder:32b

# ── Tweaks ──────────────────────────────────────────────────────────────────
# CONFESS_TOOL_MODE=json   # the diagnosis agent prompts for tool calls as JSON
#                          # instead of native tool calling — for models that
#                          # lack reliable tool-use support
# MAX_RUN_COST=5           # per-audit budget guard in USD (default 8)
# CONFESS_PRICE_INPUT=3    # exact pricing per million tokens, when the
# CONFESS_PRICE_OUTPUT=15  # built-in estimate doesn't know your provider
